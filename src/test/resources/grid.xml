<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="Parallel Tests Suite" parallel="tests" thread-count="4">

    <!-- Тесты на Chrome через Node 1 -->
