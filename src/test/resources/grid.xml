        <classes>
            <class name="grid.DataProviderGridGridTest"/>
            <class name="grid.JavaScriptExecutorGridGridTest"/>
        </classes>
    </test>

    <!-- Тесты на Chrome через Node 2 -->
    <test name="Chrome Tests - Node 2" parallel="methods" thread-count="2">
        <classes>
            <class name="grid.DataProviderGridGridTest"/>
            <class name="grid.JavaScriptExecutorGridGridTest"/>
        </classes>
    </test>

</suite>